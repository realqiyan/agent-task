{
  "name": "@realqiyan/agent-task",
  "version": "0.1.0-rc.9",
  "license": "MIT",
  "author": "realqiyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realqiyan/agent-task.git"
  },
  "homepage": "https://github.com/realqiyan/agent-task#readme",
  "bugs": "https://github.com/realqiyan/agent-task/issues",
  "bin": {
    "agent-task": "bin/agent-task.mjs"
  },
  "files": [
    "bin/agent-task.mjs",
    "dist/**/*.js",
    "dist/web/*.html",
    "dist/web/*.css",
    "scripts/setup.mjs",
    "scripts/migrate.mjs",
    "scripts/setup-wizard.mjs",
    "scripts/install-lib.mjs",
    "scripts/service-runner.mjs",
    "scripts/probe-agent.mjs",
    "scripts/mcp-call.mjs",
    "docs/*.md",
    "docs/adr/*.md",
    "CONTEXT.md",
    "config.example.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "type": "module",
  "description": "通过 MCP 管理持久任务，由智能协调者和 ACP 执行端推进交付",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "build": "rm -rf dist && tsc && node scripts/copy-web.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/deepseek-acp.test.mjs",
    "test:e2e:human": "npm run build && node scripts/run-pi-human-e2e.mjs",
    "start": "node bin/agent-task.mjs start",
    "setup": "node bin/agent-task.mjs setup",
    "prepack": "npm run build",
    "pack:release": "node scripts/pack-release.mjs",
    "plugin:local": "node scripts/create-plugin-marketplace.mjs",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "test:install": "node scripts/verify-install.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cron-parser": "5.10.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
