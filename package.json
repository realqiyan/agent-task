{
  "name": "agent-task",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable intelligent task coordination over MCP with ACP executors",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/deepseek-acp.test.mjs",
    "test:e2e:human": "npm run build && node scripts/run-pi-human-e2e.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
